# Arquivo de exemplo .env para o metadata-enricher
# Copie este arquivo para .env e preencha com seus valores.

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_server
DB_USER=user
DB_PASSWORD=password

# Chave da API do The Movie Database (TMDB)
# Obtenha a sua em https://www.themoviedb.org/signup
TMDB_API_KEY="SUA_CHAVE_DE_API_AQUI"
